# Voice Captcha Server — Environment Variables
# Copy this file to .env and fill in your values

# ============================================================
# REQUIRED
# ============================================================

# Deepfake detection via Aurigin.ai
# Sign up at https://aurigin.ai to get a key
AURIGIN_API_KEY=your_aurigin_api_key_here

# ============================================================
# OPTIONAL — Word Verification
# ============================================================

# OpenAI — required for sentence generation (GPT) and Whisper transcription
# Sign up at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Set to "none" to skip Whisper transcription (challenges still need OPENAI_API_KEY)
# TRANSCRIPTION_BACKEND=none

# Set to "none" to skip Aurigin deepfake detection
# DEEPFAKE_BACKEND=none

# Reject near-silent recordings (Whisper no_speech_prob threshold)
MAX_NO_SPEECH_PROB=0.6

# HMAC proof clock skew tolerance (milliseconds)
PROOF_MAX_SKEW_MS=60000

# Optional Aurigin API base URL override
# AURIGIN_API_URL=https://api.aurigin.ai

# ============================================================
# SERVER SETTINGS
# ============================================================

PORT=3000

# Comma-separated list of allowed origins, or * to allow all
# Example: http://localhost:8080,https://yourapp.com
ALLOWED_ORIGIN=*

# ============================================================
# RATE LIMITING
# ============================================================

# Max requests per window per IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Max verify requests per window per IP (stricter)
RATE_LIMIT_VERIFY_MAX=20

# ============================================================
# REDIS (optional — for production challenge persistence)
# ============================================================

# If not set, challenges are stored in memory (lost on restart)
# REDIS_URL=redis://localhost:6379

# ============================================================
# CHALLENGE SETTINGS
# ============================================================

# How long a challenge stays valid (milliseconds) — keep short to limit farm relay
CHALLENGE_EXPIRY_MS=90000

# Browser session lifetime (milliseconds)
SESSION_EXPIRY_MS=900000

# Minimum time after challenge load before first recording is accepted
MIN_VERIFY_ELAPSED_MS=2000

# Minimum recording offset (ms) before part 2 can be revealed
MIN_REVEAL_OFFSET_MS=500

# Tolerance (ms) when matching reveal time to Whisper word timestamps
REVEAL_OFFSET_TOLERANCE_MS=800

# Max pause (ms) allowed between consecutive words within each sentence half
MAX_WORD_GAP_MS=1000

# Challenge difficulty (1 = easiest, 10 = hardest; default 3)
CAPTCHA_DIFFICULTY=3

# Split-sentence reveal flow (true) or single full sentence (false)
CAPTCHA_TWO_PART=true

# Single-use token returned after successful verify (milliseconds)
VERIFICATION_TOKEN_TTL_MS=300000

# Secret for POST /api/siteverify — your backend uses this to redeem tokens.
# Generate with: openssl rand -hex 32
CAPTCHA_SECRET=your_captcha_secret_here
